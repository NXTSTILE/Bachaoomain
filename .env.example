# Local development: copy to .env, then configure credentials privately.
# Never put real credentials in this template or NEXT_PUBLIC_* variables.
DATABASE_URL="file:./dev.db"

# Hosted storage: use a Turso libSQL database. This overrides DATABASE_URL.
TURSO_DATABASE_URL=""
TURSO_AUTH_TOKEN=""

# Generate a fresh random secret of at least 32 characters.
JWT_SECRET=""

# Brevo transactional email, using a verified sender in your own account.
BREVO_API_KEY=""
BREVO_SENDER_EMAIL=""

NEXT_PUBLIC_SITE_URL="http://localhost:3000"
SUPPORT_EMAIL=""

# Open only after migrations and real email/auth verification pass.
REGISTRATION_OPEN="false"

# Only for loopback-bound production test fixtures; never enable on Vercel.
# AUTH_LOCAL_TESTING="1"
